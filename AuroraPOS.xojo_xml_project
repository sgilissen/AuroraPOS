 <Method>
  <ItemName>GetRFIDLogin</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1525524479</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub GetRFIDLogin(RFID As String)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim sql as String</SourceLine>
   <SourceLine>dim rs as RecordSet</SourceLine>
   <SourceLine>sql = "SELECT * FROM pos_users WHERE rfid='" + RFID +"'"</SourceLine>
   <SourceLine>rs = app.MainDB.SQLSelect(sql)</SourceLine>
   <SourceLine>Dim BOValue as String</SourceLine>
   <SourceLine>Dim DrawerValue As String</SourceLine>
   <SourceLine>Dim VoidBillValue As String</SourceLine>
   <SourceLine>Dim EndDayValue As String</SourceLine>
   <SourceLine>Dim ReportsValue As String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if rs &lt;&gt; Nil Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>BOValue = rs.Field("allow_backoffice")</SourceLine>
   <SourceLine>DrawerValue = rs.Field("allow_drawer")</SourceLine>
   <SourceLine>VoidBillValue = rs.Field("allow_voidbill")</SourceLine>
   <SourceLine>EndDayValue =rs.Field("allow_endday")</SourceLine>
   <SourceLine>ReportsValue = rs.Field("allow_reports")</SourceLine>
   <SourceLine>wndPOS.userCurrentUser = rs.Field("name")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if wndPOS.userCurrentUser &lt;&gt; "" Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if BOValue = "1" Then</SourceLine>
   <SourceLine>wndPOS.userAllowBO = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>wndPOS.userAllowBO = False</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>if DrawerValue = "1" Then</SourceLine>
   <SourceLine>wndPOS.userAllowDrawer = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>wndPOS.userAllowDrawer = False</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>if VoidBillValue = "1" Then</SourceLine>
   <SourceLine>wndPOS.userAllowVoidBill = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>wndPOS.userAllowVoidBill = False</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>if EndDayValue = "1" Then</SourceLine>
   <SourceLine>wndPOS.userAllowDayTotal = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>wndPOS.userAllowDayTotal = False</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>if ReportsValue = "1" Then</SourceLine>
   <SourceLine>wndPOS.userAllowReport = True</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>wndPOS.userAllowReport = False</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>rs.Close</SourceLine>
   <SourceLine>wndPOS.doLoginUser</SourceLine>
   <SourceLine>wndLogin.Close</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Dim MyWindowMessageBox As New wndMessageBox(LocalizationStrings.kAccessDenied, LocalizationStrings.kBadgeUnknown, 1, 0)</SourceLine>
   <SourceLine>doLogoutUser</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>MyWindowMessageBox.ShowModal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim MyWindowMessageBox As New wndMessageBox(LocalizationStrings.kAccessDenied, LocalizationStrings.kBadgeUnknown, 1, 0)</SourceLine>
   <SourceLine>doLogoutUser</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>MyWindowMessageBox.ShowModal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
