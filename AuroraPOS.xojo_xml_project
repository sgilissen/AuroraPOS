    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If EditUserMode = True Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>//App.MainDB.SQLExecute("UPDATE pos_users SET name='" + tfArtName.Text + "', price='" + tfArtPrice.Text + "', btncolor='" + str(rctButtonBG.FillColor) + "', textcolor='" + str(lblBtnCaption.TextColor) + "', vat='" + VatString + "' WHERE id=" + str(EditProductID))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.MainDB.SQLExecute("UPDATE pos_users SET name='" + tfName.Text + "', rfid='" + tfRFID.Text + "', loginpass='" + tfIDCode.Text +"', allow_backoffice='" + str(BOValue) + "', allow_voidbill='" + str(VoidBillValue) + "', allow_drawer='" + str(DrawerValue) + "', allow_endday='" + str(EndDayValue) + "', allow_reports='" + str(ReportsValue) + "' WHERE id=" + str(EditUserID))</SourceLine>
