 <HookInstance>
  <ItemName>Open</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1519648767</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Open()</SourceLine>
   <SourceLine>// Initialize preferences</SourceLine>
   <SourceLine>InitPrefFile("AuroraPOS.prf")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Get the app's Commandline Args</SourceLine>
   <SourceLine>Dim exePath As String = Chr(34) + App.ExecutableFile.NativePath +Chr(34)</SourceLine>
   <SourceLine>Dim AppCommandLine as String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>AppCommandLine = system.CommandLine.Mid(exePath.Len+1).LTrim</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>CmdLineArg = AppCommandLine</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Get the terminal environment variables</SourceLine>
   <SourceLine>Dim myShell As New Shell</SourceLine>
   <SourceLine>If TargetMacOS Then</SourceLine>
   <SourceLine>myShell.Execute("networksetup -getcomputername")</SourceLine>
   <SourceLine>If myShell.ErrorCode = 0 Then</SourceLine>
   <SourceLine>Me.computerName = myShell.Result.DefineEncoding(Encodings.UTF8)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>ElseIf TargetWin32 Then</SourceLine>
   <SourceLine>myShell.Execute("hostname")</SourceLine>
   <SourceLine>If myShell.ErrorCode = 0 Then</SourceLine>
   <SourceLine>Me.computerName = Trim(myShell.Result)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>myShell.Close</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Initialize database</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.MainDB = New SQLiteDatabase</SourceLine>
   <SourceLine>App.MainDB.DatabaseFile = SpecialFolder.Documents.Child("AuroraPOS.rsd")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.TicketDB = New SQLiteDatabase</SourceLine>
   <SourceLine>App.TicketDB.DatabaseFile = SpecialFolder.Documents.Child("bp-tickets.rsd")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Connect to the database</SourceLine>
   <SourceLine>if MainDB.databaseFile.exists = true then</SourceLine>
   <SourceLine>// The database file already exists, so we want to connect to it.</SourceLine>
   <SourceLine>if MainDB.Connect() = false then</SourceLine>
   <SourceLine>DisplayDatabaseError(MainDB, false )// there was an error connecting to the database</SourceLine>
   <SourceLine>Quit</SourceLine>
   <SourceLine>return</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>// The database file does not exist so we want to create a new one.</SourceLine>
   <SourceLine>// The process of creating a database will establish a connection to it</SourceLine>
   <SourceLine>// so there isn't a need to call Database.Connect after we create it.</SourceLine>
   <SourceLine>CreateDatabaseFile</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>end</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If TicketDB.DatabaseFile.Exists = True Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if TicketDB.Connect() = false then</SourceLine>
   <SourceLine>DisplayDatabaseError(App.TicketDB, false )// there was an error connecting to the database</SourceLine>
   <SourceLine>Quit</SourceLine>
   <SourceLine>return</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else </SourceLine>
   <SourceLine>CreateDatabaseFile</SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Set the application to AutoQuit, so if all windows are closed then the application</SourceLine>
   <SourceLine>// will quit.</SourceLine>
   <SourceLine>app.autoQuit = true</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//check Prefs if app should start in POS</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If AppCommandLine = "-forcebo" Then</SourceLine>
   <SourceLine>wndBackOffice.Show</SourceLine>
   <SourceLine>msgBox("BackOffice geforceerd geopend. Gelieve uw instellingen aan te passen en de commandline switch te verwijderen indien dit in een snelkoppeling gebeurd is.")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Elseif GetPrefBoolean("StartupInPOS", false) = True Then</SourceLine>
   <SourceLine>wndPOS.show</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>wndBackOffice.Show</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
 </HookInstance>
