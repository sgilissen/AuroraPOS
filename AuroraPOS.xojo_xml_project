   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if GetPrefBoolean("POSShowVoidTickets", False) = True Then</SourceLine>
   <SourceLine>sql = "SELECT * FROM pos_sales"</SourceLine>
   <SourceLine>ElseIf GetPrefBoolean("POSShowVoidTickets", False) = False Then</SourceLine>
   <SourceLine>sql = "SELECT * FROM pos_sales WHERE billvoid=0"</SourceLine>
   <SourceLine>End If</SourceLine>
