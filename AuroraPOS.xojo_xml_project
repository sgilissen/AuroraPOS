   <SourceLine></SourceLine>
   <SourceLine>//Selection</SourceLine>
   <SourceLine>default.ListIndex=GetPrefNumber(fieldName+" Selection", default.ListIndex)</SourceLine>
   <SourceLine>default.Refresh</SourceLine>
   <SourceLine>End Sub</SourceLine>
