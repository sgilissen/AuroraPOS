   <SourceLine>Sub GetPrefPopupMenu(fieldName as string, default as PopupMenu)</SourceLine>
   <SourceLine>Dim n,total as integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//Items</SourceLine>
   <SourceLine>total=GetPrefNumber(fieldName+" Items",0)</SourceLine>
   <SourceLine>if total &lt;&gt; 0 Then</SourceLine>
   <SourceLine>default.DeleteAllRows</SourceLine>
   <SourceLine>for n=0 to total-1</SourceLine>
   <SourceLine>default.AddRow GetPrefString(fieldName+" Item "+Str(n),"")</SourceLine>
   <SourceLine>next</SourceLine>
