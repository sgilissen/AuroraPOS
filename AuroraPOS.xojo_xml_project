   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 2) = rs.Field("article")</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 3) = rs.Field("amount")</SourceLine>
