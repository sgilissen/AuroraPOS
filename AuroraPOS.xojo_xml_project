   <SourceLine>if lbTickets.ListCount &lt; 1 Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>lbTickets.AddRow</SourceLine>
   <SourceLine>lbTickets.RowTag(lbTickets.LastIndex) = TicketID</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 0) = rs.Field("id")</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 1) = TicketID</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 2) = rs.Field("article")</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 3) = rs.Field("amount")</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 4) = rs.Field("price")</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 5) = rs.Field("total")</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 6) = rs.Field("timestamp")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>for CurrentRow As Integer = 0 to lbTickets.ListCount -1</SourceLine>
   <SourceLine>if lbTickets.RowTag(lbTickets.LastIndex) = TicketID Then</SourceLine>
   <SourceLine>UpdateRow = CurrentRow</SourceLine>
   <SourceLine>UpdateRowFound = True</SourceLine>
   <SourceLine>Exit</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UpdateRowFound = False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if UpdateRowFound = True Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim NumberOfTickets As Integer</SourceLine>
   <SourceLine>dim NewTotal As Double</SourceLine>
   <SourceLine>NumberOfTickets = Cdbl(lbTickets.Cell(UpdateRow, 0)) +1</SourceLine>
   <SourceLine>NewTotal = Cdbl(lbTickets.Cell(UpdateRow, 5)) + Cdbl(rs.field("total"))</SourceLine>
   <SourceLine>lbTickets.Cell(UpdateRow, 5) = str(NewTotal)</SourceLine>
   <SourceLine>UpdateRowFound = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>lbTickets.AddRow</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 0) = rs.Field("id")</SourceLine>
