   <NoteLine></NoteLine>
   <NoteLine>Redim prefNames(-1)</NoteLine>
   <NoteLine>Redim prefItems(-1)</NoteLine>
   <NoteLine></NoteLine>
   <NoteLine>// check, if CompanyName is regularly set (WIN)</NoteLine>
   <NoteLine>// check, if ProductName is regularly set (WIN and Linux)</NoteLine>
   <NoteLine></NoteLine>
   <NoteLine>#if TargetWin32 then</NoteLine>
   <NoteLine>if prefFolderName = "" then</NoteLine>
   <NoteLine>if kCompanyName &lt;&gt;"" then</NoteLine>
   <NoteLine>prefFolderName = kCompanyName</NoteLine>
   <NoteLine>end if</NoteLine>
   <NoteLine>end if</NoteLine>
   <NoteLine>if prefName = "" then</NoteLine>
   <NoteLine>if kProductName &lt;&gt; "" then</NoteLine>
   <NoteLine>prefName = kProductName</NoteLine>
   <NoteLine>end if</NoteLine>
   <NoteLine>end if</NoteLine>
   <NoteLine>#else</NoteLine>
   <NoteLine>if prefName = "" then</NoteLine>
   <NoteLine>if kProductName &lt;&gt; "" then</NoteLine>
   <NoteLine>prefName = kProductName</NoteLine>
   <NoteLine>end if</NoteLine>
   <NoteLine>end</NoteLine>
