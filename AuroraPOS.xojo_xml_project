  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function GetPrefColor(fieldName as string, default as Color) As Color</SourceLine>
   <SourceLine>Dim colString as string</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>colString=Str(default.red)+","+Str(default.green)+","+Str(default.blue)</SourceLine>
   <SourceLine>colString=GetPrefString(fieldName,colString)</SourceLine>
   <SourceLine>return RGB(Cdbl(NthField(colString,",",1)),Cdbl(NthField(colString,",",2)),Cdbl(NthField(colString,",",3)))</SourceLine>
