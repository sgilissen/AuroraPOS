    <SourceLine>m = PopUpMonth.listindex+1</SourceLine>
    <SourceLine>y = Cdbl(PopUpYear.text)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if m=12 and y&lt;2039 then</SourceLine>
