   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>82331647</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>//User wants to back up a month</SourceLine>
    <SourceLine>//If not at limits of dates(Jan,1904) then do it</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Dim m,y As Integer</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>m = MonthPopup.ListIndex + 1</SourceLine>
    <SourceLine>y = Cdbl(YearPopup.Text)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If m = 1 And y &gt; StartYear Then</SourceLine>
    <SourceLine>YearPopup.ListIndex = YearPopup.ListIndex - 1</SourceLine>
    <SourceLine>MonthPopup.ListIndex = 11</SourceLine>
    <SourceLine>Elseif m &gt; 1 Then</SourceLine>
    <SourceLine>MonthPopup.ListIndex = MonthPopup.ListIndex - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
 </ControlBehavior>
