   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action(art As Article)</SourceLine>
    <SourceLine>Dim AddArticle As Boolean</SourceLine>
    <SourceLine>AddArticle = False </SourceLine>
    <SourceLine>Dim SelectedAmt As String</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>SelectedAmt = lbAmount.Cell(lbAmount.ListIndex, 0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If art.VarName = True Then</SourceLine>
    <SourceLine>dim MyOSKWindow As New wndOSK()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>MyOSKWindow.ShowModal</SourceLine>
    <SourceLine>if MyOSKWindow.Text = "" Then</SourceLine>
    <SourceLine>art.name = art.name + ": " + MyOSKWindow.Text</SourceLine>
    <SourceLine>AddArticle = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>AddArticle = False</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else </SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>AddArticle = True</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if AddArticle = True Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Art.VarPrice = True Then</SourceLine>
    <SourceLine>Dim MyNumberPadWindow As New wndNumberPad()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>MyNumberPadWindow.ShowModal</SourceLine>
    <SourceLine>art.price = MyNumberPadWindow.Value</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if lbBill.ListCount  &lt; 1 Then</SourceLine>
    <SourceLine>lbBill.AddRow(SelectedAmt)</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 1) = art.name</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 2) = format(art.price, "#.00")</SourceLine>
    <SourceLine>//lbBill.Cell(lbBill.LastIndex, 3) = format(art.price, "#.00")</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 3) = format(Cdbl(lbBill.Cell(lbBill.LastIndex, 2)) * Cdbl(lbBill.Cell(lbBill.LastIndex, 0)), "#.00")</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 4) = str(art.GroupID)</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 5) = str(art.VATID)</SourceLine>
    <SourceLine>lbBill.RowTag(lbBill.LastIndex) = art.artID</SourceLine>
    <SourceLine>lbBill.ScrollPosition = lbBill.LastIndex</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>UpdateRowFound = False</SourceLine>
    <SourceLine>'if lbBill.RowTag(lbBill.LastIndex) = art.ArtID Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>For CurrentRow As Integer = 0 to lbBill.ListCount -1</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if lbBill.RowTag(CurrentRow) = art.artID Then</SourceLine>
    <SourceLine>UpdateRow = CurrentRow</SourceLine>
    <SourceLine>UpdateRowFound = True</SourceLine>
    <SourceLine>Exit</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if UpdateRowFound = True Then</SourceLine>
    <SourceLine>dim NumberOfArts As Integer</SourceLine>
    <SourceLine>NumberOfArts = Cdbl(lbBill.Cell(UpdateRow, 0)) +Cdbl(SelectedAmt)</SourceLine>
    <SourceLine>lbBill.Cell(UpdateRow, 0) = str(NumberOfArts)</SourceLine>
    <SourceLine>lbBill.Cell(UpdateRow, 3) = format(Cdbl(lbBill.Cell(UpdateRow, 2)) * NumberOfArts, "#.00")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>UpdateRowFound = False</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>lbBill.AddRow(SelectedAmt)</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 1) = art.name</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 2) = format(art.price, "#.00")</SourceLine>
    <SourceLine>//lbBill.Cell(lbBill.LastIndex, 3) = format(art.price, "#.00")</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 3) = format(Cdbl(lbBill.Cell(lbBill.LastIndex, 2)) * Cdbl(lbBill.Cell(lbBill.LastIndex, 0)), "#.00")</SourceLine>
    <SourceLine>lbBill.RowTag(lbBill.LastIndex) = art.artID</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 4) =  str(art.GroupID)</SourceLine>
    <SourceLine>lbBill.Cell(lbBill.LastIndex, 5) = str(art.VATID)</SourceLine>
    <SourceLine>lbBill.ScrollPosition = lbBill.LastIndex</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>dim Sum as Double = 0</SourceLine>
    <SourceLine>dim SingleValue as Double</SourceLine>
    <SourceLine>for i As integer = 0 to lbBill.ListCount -1</SourceLine>
    <SourceLine>SingleValue = Cdbl(lbBill.Cell(i,3))</SourceLine>
    <SourceLine>sum = sum + SingleValue</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>next</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>TotalSum = Sum</SourceLine>
    <SourceLine>asDMDTotal.Caption = "€ " +  format(sum, "#.00") +"  " +"  "</SourceLine>
    <SourceLine>asDMDTotal.Refresh</SourceLine>
    <SourceLine>lbAmount.ListIndex = 0</SourceLine>
    <SourceLine>lbAmount.Cell(9, 0) = "?"</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
