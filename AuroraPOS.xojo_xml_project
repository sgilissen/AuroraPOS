 <ControlBehavior>
  <Superclass>ASPushButton</Superclass>
  <HookInstance>
   <ItemName>Action</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>20525055</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If wndPOS.lbBill.ListCount &lt; 1 Then</SourceLine>
    <SourceLine>dim MyMsgBox As New wndMessageBox(LocalizationStrings.kNoItems, LocalizationStrings.kDidNotSpecifyItems, 0, 0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>dim Row As New DatabaseRecord</SourceLine>
    <SourceLine>dim D As Date</SourceLine>
    <SourceLine>dim BillID As String</SourceLine>
    <SourceLine>D = New Date</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>BillID = format(d.Year, "0000") + format(d.Month, "00") + format(d.Day, "00") + format(D.Hour, "00") + format(d.Minute, "00") + Format(d.Second, "00")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if tfName.Text &lt;&gt; "" Then</SourceLine>
    <SourceLine>App.TicketDB.BeginTransaction</SourceLine>
    <SourceLine>//"CREATE TABLE pos_sales (id Integer PRIMARY KEY AUTOINCREMENT, billid Integer,  article VarChar, amount Integer, price Double, total Double,  timestamp VarChar, day VarChar, month VarChar, year VarCh, paymentmethod VarChar, invoice VarChar)"</SourceLine>
    <SourceLine>For x As Integer = 0 to wndPOS.lbBill.ListCount -1</SourceLine>
    <SourceLine>row.Column("billid") = BillID</SourceLine>
    <SourceLine>row.Column("customername") = tfName.Text</SourceLine>
    <SourceLine>row.Column("amount") = wndPOS.lbBill.Cell(x, 0)</SourceLine>
    <SourceLine>row.Column("article") = wndPOS.lbBill.Cell(x, 1)</SourceLine>
    <SourceLine>row.Column("price") = wndPOS.lbBill.Cell(x, 2)</SourceLine>
    <SourceLine>row.Column("total") = wndPOS.lbBill.Cell(x, 3)</SourceLine>
    <SourceLine>row.Column("timestamp") = d.SQLDateTime</SourceLine>
    <SourceLine>row.Column("day") = str(d.Day)</SourceLine>
    <SourceLine>row.Column("month") = str(d.Month)</SourceLine>
    <SourceLine>row.Column("year") = str(d.Year)</SourceLine>
    <SourceLine>row.Column("paymentmethod") = "CASH"</SourceLine>
    <SourceLine>row.Column("employee") = wndPOS.userCurrentUser</SourceLine>
    <SourceLine>row.Column("billvoid") = "0"</SourceLine>
    <SourceLine>row.Column("groupid") = wndPOS.lbBill.Cell(x, 4)</SourceLine>
    <SourceLine>row.Column("vatid") = wndPOS.lbBill.Cell(x, 5)</SourceLine>
    <SourceLine>App.TicketDB.InsertRecord("pos_openbills", row)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if App.TicketDB.Error then</SourceLine>
    <SourceLine>msgBox("Error: " + App.TicketDB.ErrorMessage)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>end if</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>App.TicketDB.CommitTransaction</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if App.TicketDB.Error then</SourceLine>
    <SourceLine>msgBox("Error: " + App.TicketDB.ErrorMessage)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>end if</SourceLine>
    <SourceLine>if GetPrefBoolean("LogoutAfterBill", True) = True Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>wndOpenBills.Close</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>wndPOS.DoLogoutUser</SourceLine>
    <SourceLine>wndPOS.lbBill.DeleteAllRows</SourceLine>
    <SourceLine>wndPOS.TotalSum = 0</SourceLine>
    <SourceLine>wndPOS.asDMDTotal.Caption = "€ " +  format(0, "#.00")</SourceLine>
    <SourceLine>wndPOS.asDMDTotal.Refresh</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>wndOpenBills.Close</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>wndPOS.lbBill.DeleteAllRows</SourceLine>
    <SourceLine>wndPOS.TotalSum = 0</SourceLine>
    <SourceLine>wndPOS.asDMDTotal.Caption = "€ " +  format(0, "#.00")</SourceLine>
    <SourceLine>wndPOS.asDMDTotal.Refresh</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
 </ControlBehavior>
