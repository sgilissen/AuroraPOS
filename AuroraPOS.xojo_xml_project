  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1154711551</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub SetPrefPopupMenu(fieldName as string, fieldValue as PopupMenu)</SourceLine>
   <SourceLine>Dim n,total as integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//----Remove</SourceLine>
   <SourceLine>// Old Items</SourceLine>
   <SourceLine>total=GetPrefNumber(fieldName+" Items",0)</SourceLine>
   <SourceLine>DeletePref(fieldName+" Items")</SourceLine>
   <SourceLine>for n=0 to total-1</SourceLine>
   <SourceLine>DeletePref(fieldName+" Item "+Str(n))</SourceLine>
   <SourceLine>next</SourceLine>
   <SourceLine>// Selection</SourceLine>
   <SourceLine>DeletePref(fieldName+" Selection")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//-----Add New</SourceLine>
   <SourceLine>// Items</SourceLine>
   <SourceLine>SetPrefNumber(fieldName+" Items",fieldValue.ListCount)</SourceLine>
   <SourceLine>for n=0 to fieldValue.ListCount-1</SourceLine>
   <SourceLine>SetPrefString(fieldName+" Item "+Str(n),fieldValue.List(n))</SourceLine>
   <SourceLine>next</SourceLine>
   <SourceLine>// Selection</SourceLine>
   <SourceLine>SetPrefNumber(fieldName+" Selection",fieldValue.ListIndex)</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
