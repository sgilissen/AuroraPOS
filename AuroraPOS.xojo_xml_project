    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Paint(g As Graphics, areas() As REALbasic.Rect)</SourceLine>
    <SourceLine>// Message Types:</SourceLine>
    <SourceLine>//</SourceLine>
    <SourceLine>// 1 = Red</SourceLine>
    <SourceLine>// 2 = Green</SourceLine>
    <SourceLine>// 3 = Orange</SourceLine>
    <SourceLine>// 4 = Timed Orange, after timeout = Cancel</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if MessageType = 1 Then</SourceLine>
    <SourceLine>g.DrawPicture(error64, 0,0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>ElseIf MessageType = 2 Then</SourceLine>
    <SourceLine>g.DrawPicture(caution64, 0,0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>ElseIf MessageType = 3 Then</SourceLine>
    <SourceLine>g.DrawPicture(caution64, 0,0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>ElseIf MessageType = 4 Then</SourceLine>
    <SourceLine>g.DrawPicture(caution64, 0,0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>ElseIf MessageType = 5 Then</SourceLine>
    <SourceLine>g.DrawPicture(question64, 0,0)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>g.DrawPicture(caution64, 0,0)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
