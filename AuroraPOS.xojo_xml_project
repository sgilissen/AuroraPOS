    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Change()</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Dim Art As Article</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>dim i as Integer</SourceLine>
    <SourceLine>dim buttonCount As Integer</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>buttonCount = ButtonGrid1.Buttons.Ubound</SourceLine>
    <SourceLine>For i = buttonCount DownTo 0 Step 1</SourceLine>
    <SourceLine>ButtonGrid1.Buttons.Remove(ButtonCount)</SourceLine>
