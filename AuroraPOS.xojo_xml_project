 <Method>
  <ItemName>PopulateListBox</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>731742207</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub PopulateListBox(lb as listBox, rs as recordSet)</SourceLine>
   <SourceLine>// Populate the specified listbox with the data in the recordset</SourceLine>
   <SourceLine>// that is provided.  This will loop through the records in the</SourceLine>
   <SourceLine>// recordset and add rows to the listbox that contain the data</SourceLine>
   <SourceLine>// from the recordset.</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim i as integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Clear the order list</SourceLine>
   <SourceLine>lb.deleteAllRows</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Loop until we reach the end of the recordset</SourceLine>
   <SourceLine>while not rs.eof</SourceLine>
   <SourceLine>lb.addRow ""// add a new row to the listbox</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Loop through all of the fields in the recordset and add the data to the correct</SourceLine>
   <SourceLine>// column in the listbox</SourceLine>
   <SourceLine>for i = 1 to rs.fieldCount</SourceLine>
   <SourceLine>// The listbox Cell property is 0-based so we need to subtract 1 from the database field</SourceLine>
   <SourceLine>// number to get the correct correct column number.  This means field 1 is in column 0 of</SourceLine>
   <SourceLine>// the listbox.</SourceLine>
   <SourceLine>lb.cell( lb.lastIndex, i-1 ) = rs.idxField( i ).stringValue</SourceLine>
   <SourceLine>next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>rs.moveNext// move to the next record</SourceLine>
   <SourceLine>wend</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// If the listbox is set to be sorted by a particular column then we want to</SourceLine>
   <SourceLine>// sort the listbox contents after we populate it, so that they appear in the</SourceLine>
   <SourceLine>// correct order.</SourceLine>
   <SourceLine>if lb.sortedColumn &gt; -1 then// the listbox is sorted by a column</SourceLine>
   <SourceLine>lb.sort// sort the listbox data using the current sort settings</SourceLine>
   <SourceLine>end</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>lb.Refresh</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>33</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>lb as listBox, rs as recordSet</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>UpdateOpenBills</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>778661887</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UpdateOpenBills()</SourceLine>
   <SourceLine>Dim AddTicket As Boolean</SourceLine>
   <SourceLine>dim UpdateRowFound As Boolean</SourceLine>
   <SourceLine>Dim UpdateRow As Integer</SourceLine>
   <SourceLine>Dim FirstTicketDate As String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>lbTickets.DeleteAllRows</SourceLine>
   <SourceLine>dim TicketID As String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim i as Integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim sql as String</SourceLine>
   <SourceLine>dim rs as RecordSet</SourceLine>
   <SourceLine>sql = "SELECT * FROM pos_openbills"</SourceLine>
   <SourceLine>rs = app.TicketDB.SQLSelect(sql)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if rs &lt;&gt; Nil Then</SourceLine>
   <SourceLine>while not rs.eof</SourceLine>
   <SourceLine>TicketID = rs.Field("customername")</SourceLine>
   <SourceLine>CurrentID = TicketID</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if lbTickets.ListCount &lt; 1 Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>lbTickets.AddRow</SourceLine>
   <SourceLine>lbTickets.RowTag(lbTickets.LastIndex) = TicketID</SourceLine>
   <SourceLine>FirstTicketDate = rs.Field("day").StringValue + "/" + rs.Field("month").StringValue + "/" + rs.Field("year").StringValue</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 0) = FirstTicketDate</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 1) = TicketID</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>for CurrentRow As Integer = 0 to lbTickets.ListCount -1 </SourceLine>
   <SourceLine>if lbTickets.Cell(CurrentRow, 1) = TicketID Then</SourceLine>
   <SourceLine>UpdateRowFound = True</SourceLine>
   <SourceLine>Exit</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UpdateRowFound = False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If UpdateRowFound = False Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>lbTickets.AddRow</SourceLine>
   <SourceLine>lbTickets.RowTag(lbTickets.LastIndex) = TicketID</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 1) = TicketID</SourceLine>
   <SourceLine>FirstTicketDate = rs.Field("day").StringValue + "/" + rs.Field("month").StringValue + "/" + rs.Field("year").StringValue</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 0) = FirstTicketDate</SourceLine>
   <SourceLine>lbTickets.Cell(lbTickets.LastIndex, 1) = TicketID</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>rs.moveNext// move to the next record</SourceLine>
   <SourceLine>wend</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>UpdateSalesList</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1552918527</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UpdateSalesList()</SourceLine>
   <SourceLine>lbSales.DeleteAllRows</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim i as Integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim sql as String</SourceLine>
   <SourceLine>dim rs as RecordSet</SourceLine>
   <SourceLine>sql = "SELECT * FROM pos_openbills WHERE customername='" + lbTickets.Cell(lbTickets.ListIndex, 1) + "'"</SourceLine>
   <SourceLine>rs = app.TicketDB.SQLSelect(sql)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if rs &lt;&gt; Nil Then</SourceLine>
   <SourceLine>while not rs.eof</SourceLine>
   <SourceLine>lbSales.AddRow</SourceLine>
   <SourceLine>for i = 1 to rs.FieldCount</SourceLine>
   <SourceLine>lbSales.Cell(lbSales.LastIndex, 0) = rs.Field("amount")</SourceLine>
   <SourceLine>lbSales.Cell(lbSales.LastIndex, 1) = rs.Field("article")</SourceLine>
   <SourceLine>lbSales.Cell(lbSales.LastIndex, 2) = rs.Field("price")</SourceLine>
   <SourceLine>lbSales.Cell(lbSales.LastIndex, 3) = rs.Field("total")</SourceLine>
   <SourceLine>lbSales.Cell(lbSales.LastIndex, 4) = rs.Field("groupid")</SourceLine>
   <SourceLine>lbSales.Cell(lbSales.LastIndex, 5) = rs.field("vatid")</SourceLine>
   <SourceLine>next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>rs.moveNext// move to the next record</SourceLine>
   <SourceLine>wend</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>msgBox lbTickets.Cell(lbTickets.ListIndex, 1) + " niet gevonden"</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim Sum as Double = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>dim SingleValue as Double</SourceLine>
   <SourceLine>for x As integer = 0 to lbSales.ListCount -1</SourceLine>
   <SourceLine>SingleValue = Cdbl(lbSales.Cell(x,3))</SourceLine>
   <SourceLine>sum = sum + SingleValue</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>lblTotal.Text = "€ " +  format(sum, "#.00")</SourceLine>
   <SourceLine>TotalEndSum = sum</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
