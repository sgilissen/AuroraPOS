   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Paint(g As Graphics, areas() As REALbasic.Rect)</SourceLine>
   <SourceLine>dim TextColor As Color</SourceLine>
   <SourceLine>dim TextX As Integer</SourceLine>
   <SourceLine>dim TextY As Integer</SourceLine>
   <SourceLine>dim MyStartColor As Color</SourceLine>
   <SourceLine>dim MyEndColor As Color</SourceLine>
   <SourceLine>dim BorderTopLeftColor As Color</SourceLine>
   <SourceLine>dim BorderBottomRightColor As Color</SourceLine>
   <SourceLine>dim OuterBorderColor As Color</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim startColor As Color</SourceLine>
   <SourceLine>Dim endColor As Color</SourceLine>
   <SourceLine>Dim TopLeftColor As Color </SourceLine>
   <SourceLine>Dim BottomRightColor As Color</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if ButtonColor = 0 Then //Grey</SourceLine>
   <SourceLine>MyStartColor = RGB(63,67,73)</SourceLine>
   <SourceLine>MyEndColor = RGB(94,99,105)</SourceLine>
   <SourceLine>BorderTopLeftColor = RGB(110,110,115)</SourceLine>
   <SourceLine>BorderBottomRightColor = RGB(80,80,80)</SourceLine>
   <SourceLine>OuterBorderColor = RGB(48,48,48)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf ButtonColor = 1 Then //Red</SourceLine>
   <SourceLine>BorderTopLeftColor = RGB(162,90,88)</SourceLine>
   <SourceLine>BorderBottomRightColor = RGB(91,40,38)</SourceLine>
   <SourceLine>MyStartColor = RGB(114,35,34)</SourceLine>
   <SourceLine>MyEndColor = RGB(148,54,52)</SourceLine>
   <SourceLine>OuterBorderColor = RGB(48,48,48)</SourceLine>
