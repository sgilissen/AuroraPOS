    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>Dim D As New Date</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Dim Months(11) As String</SourceLine>
    <SourceLine>Months(0) = "JANUARI"</SourceLine>
    <SourceLine>Months(1) = "FEBRUARI"</SourceLine>
    <SourceLine>Months(2) = "MAART"</SourceLine>
    <SourceLine>Months(3) = "APRIL" </SourceLine>
    <SourceLine>Months(4) = "MEI"</SourceLine>
    <SourceLine>Months(5) = "JUNI"</SourceLine>
    <SourceLine>Months(6) = "JULI"</SourceLine>
    <SourceLine>Months(7) = "AUGUSTUS"</SourceLine>
    <SourceLine>Months(8) = "SEPTEMBER"</SourceLine>
    <SourceLine>Months(9) = "OKTOBER"</SourceLine>
    <SourceLine>Months(10) = "NOVEMBER"</SourceLine>
    <SourceLine>Months(11) = "DECEMBER"</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Dim Days(6) As String</SourceLine>
    <SourceLine>Days(0) = "ZONDAG"</SourceLine>
    <SourceLine>Days(1) = "MAANDAG"</SourceLine>
    <SourceLine>Days(2) = "DINSDAG"</SourceLine>
    <SourceLine>Days(3) = "WOENSDAG"</SourceLine>
    <SourceLine>Days(4) = "DONDERDAG"</SourceLine>
    <SourceLine>Days(5) = "VRIJDAG"</SourceLine>
    <SourceLine>Days(6) = "ZATERDAG"</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>lblDayNumber.Text = Format(D.Day, "00")</SourceLine>
    <SourceLine>lblYear.Text = str(D.Year)</SourceLine>
    <SourceLine>lblDayName.Text = str(Days(D.DayOfWeek -1))</SourceLine>
    <SourceLine>lblMonth.Text = Months(D.Month-1)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>lblHour.Text = Format(D.Hour, "00")</SourceLine>
    <SourceLine>lblMinute.Text = Format(D.Minute, "00")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if lblTimeSpacer.Visible = True Then</SourceLine>
    <SourceLine>lblTimeSpacer.Visible = False</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>lblTimeSpacer.Visible = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
