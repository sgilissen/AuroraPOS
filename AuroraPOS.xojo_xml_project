 <ObjName>ButtonGrid</ObjName>
 <ObjContainerID>0</ObjContainerID>
 <IsClass>1</IsClass>
 <Superclass>Canvas</Superclass>
 <ItemFlags>1</ItemFlags>
 <IsInterface>0</IsInterface>
 <Compatibility></Compatibility>
 <HookInstance>
  <ItemName>Paint</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>947451903</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Paint(g As Graphics, areas() As REALbasic.Rect)</SourceLine>
   <SourceLine>if me.ClearAll = False Then</SourceLine>
   <SourceLine>dim i, x, y as integer</SourceLine>
   <SourceLine>dim buttonLocX, buttonLocY, mouseLocX, mouseLocY as Integer</SourceLine>
   <SourceLine>dim bx, by, bw, bh as Integer</SourceLine>
   <SourceLine>dim ButtonNameText as String</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>g.ForeColor = rgb(34,34,38)</SourceLine>
   <SourceLine>g.FillRect(0, 0, me.Width, me.Height)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>mouseLocX = mouseX * 5 \ Width</SourceLine>
   <SourceLine>mouseLocY = mouseY * 5 \ Height</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>for i = 0 to ubound(Buttons)</SourceLine>
   <SourceLine>// calculate </SourceLine>
   <SourceLine>buttonLocX = i mod 5</SourceLine>
   <SourceLine>buttonLocY = i \ 5</SourceLine>
   <SourceLine>// buttonLocY = i mod 6</SourceLine>
   <SourceLine>bx = buttonLocX * width \ 5</SourceLine>
   <SourceLine>//by = buttonLocY * 64</SourceLine>
   <SourceLine>by = buttonLocY * height \ 5</SourceLine>
   <SourceLine>bw = width \ 5</SourceLine>
   <SourceLine>bh = height \ 5</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>g.ForeColor = Buttons(i).ButtonColor</SourceLine>
   <SourceLine>g.FillRect(bx, by, bw, bh)</SourceLine>
   <SourceLine>// draw border</SourceLine>
   <SourceLine>if System.MouseDown and mouseLocX = buttonLocX and mouseLocY = buttonLocY then</SourceLine>
   <SourceLine>g.ForeColor = rgb(192, 192, 192)</SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>g.ForeColor = rgb(64, 64, 64)</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine>g.DrawRect(bx, by, bw, bh)</SourceLine>
   <SourceLine>//g.DrawRect(bx+1, by+1, bw-2, bh-2)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// draw text</SourceLine>
   <SourceLine>g.ForeColor = Buttons(i).TextColor</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if Len(Buttons(i).name) &gt; 9 Then</SourceLine>
   <SourceLine>g.TextSize = 10</SourceLine>
   <SourceLine>ElseIf Len(Buttons(i).name) &lt; 9 Then</SourceLine>
   <SourceLine>g.TextSize = 20</SourceLine>
   <SourceLine>ElseIf Len(Buttons(i).name) &gt; 11 Then</SourceLine>
   <SourceLine>g.TextSize = 8</SourceLine>
   <SourceLine>ElseIf Len(Buttons(i).name) &gt; 15 Then</SourceLine>
   <SourceLine>g.TextSize = 6</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>if Len(Buttons(i).Name) &gt; 18 Then</SourceLine>
   <SourceLine>ButtonNameText = Left(Buttons(i).name, 15) + "..."</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>ButtonNameText = Buttons(i).name</SourceLine>
   <SourceLine>End If</SourceLine>
