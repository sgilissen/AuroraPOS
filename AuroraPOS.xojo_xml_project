  <HookInstance>
   <ItemName>Action</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>259008511</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>dim VatString As String</SourceLine>
    <SourceLine>if popVAT.Text = "Tarief 1" Then</SourceLine>
    <SourceLine>VatString = "1"</SourceLine>
    <SourceLine>ElseIf popVAT.Text = "Tarief 2" Then</SourceLine>
    <SourceLine>VatString = "2"</SourceLine>
    <SourceLine>ElseIf popVAT.Text = "Tarief 3" Then</SourceLine>
    <SourceLine>VatString = "3"</SourceLine>
    <SourceLine>ElseIf popVAT.Text = "Tarief 4" Then</SourceLine>
    <SourceLine>VatString = "4"</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If EditProductMode = True Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.MainDB.SQLExecute("UPDATE pos_articles SET name='" + tfArtName.Text + "', price='" + tfArtPrice.Text + "', btncolor='" + str(rctButtonBG.FillColor) + "', textcolor='" + str(lblBtnCaption.TextColor) + "', vat='" + VatString + "' WHERE id=" + str(EditProductID))</SourceLine>
    <SourceLine>App.MainDB.Commit</SourceLine>
    <SourceLine>wndAddEditProduct.Close</SourceLine>
    <SourceLine>wndBackOffice.UpdateArticleList</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if App.MainDB.Error Then</SourceLine>
    <SourceLine>MsgBox("Database Error: " + App.MainDB.ErrorMessage)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>EditProductMode = False</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>dim Row As New DatabaseRecord</SourceLine>
    <SourceLine>row.Column("name") = tfArtName.text</SourceLine>
    <SourceLine>row.Column("price") = tfArtPrice.text</SourceLine>
    <SourceLine>row.Column("GroupID") = wndBackOffice.lbArtGroups.Cell(wndBackOffice.lbArtGroups.ListIndex, 0)</SourceLine>
    <SourceLine>row.Column("btncolor") = str(rctButtonBG.FillColor)</SourceLine>
    <SourceLine>row.Column("textcolor") = str(lblBtnCaption.TextColor)</SourceLine>
    <SourceLine>row.Column("vat") = VatString</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.MainDB.InsertRecord("pos_articles", row)</SourceLine>
    <SourceLine>App.MainDB.Commit</SourceLine>
    <SourceLine>wndAddEditProduct.Close</SourceLine>
    <SourceLine>wndBackOffice.UpdateArticleList</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>if App.MainDB.Error Then</SourceLine>
    <SourceLine>MsgBox("Database Error: " + App.MainDB.ErrorMessage)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
