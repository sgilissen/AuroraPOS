 <Method>
  <ItemName>GetDate</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1421391871</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function GetDate(d as date) As Double</SourceLine>
   <SourceLine>//Call this from another window to allow user to select a date</SourceLine>
   <SourceLine>//format:  myDate.totalSeconds = Calendar.GetDate(CurrentDate)</SourceLine>
   <SourceLine>//CurrentDate will be month displayed to start with, can be same as myDate</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//Take the date given and set the day to one to prevent</SourceLine>
   <SourceLine>//errors when a user advances a month with Jan31 for example</SourceLine>
   <SourceLine>//then update window</SourceLine>
   <SourceLine>whichDate = new date</SourceLine>
   <SourceLine>whichDate.totalSeconds = d.totalseconds</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>whichDate.day = 1</SourceLine>
   <SourceLine>whichDate.totalSeconds = whichDate.totalSeconds</SourceLine>
   <SourceLine>update</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//Stop code execution of this window until user chooses a date</SourceLine>
   <SourceLine>self.showmodal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//User has picked a date, window is closing, return the new value</SourceLine>
   <SourceLine>return whichDate.totalseconds</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>d as date</ItemParams>
  <ItemResult>Double</ItemResult>
 </Method>
 <Method>
  <ItemName>update</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1572163583</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub update()</SourceLine>
   <SourceLine>dim i,maxday,DofW,DayNum as integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>PopupMonth.listindex = whichDate.month-1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//If desired the year popUpMenu can be changed to only</SourceLine>
   <SourceLine>//include certain years, or for example only ten years</SourceLine>
   <SourceLine>//either side of the current year.</SourceLine>
   <SourceLine>//Remove code from open event and use following code instead</SourceLine>
   <SourceLine>'PopupYear.deleteAllRows</SourceLine>
   <SourceLine>'for i = 1904 to 2039 //or:  whichDate.month-10, etc.</SourceLine>
   <SourceLine>'PopupYear.addrow Str(i)</SourceLine>
   <SourceLine>'next</SourceLine>
   <SourceLine>PopupYear.listindex = whichDate.year-1904</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//find how many days in this month</SourceLine>
   <SourceLine>i = whichDate.month</SourceLine>
   <SourceLine>if i=1 or i=3 or i=5 or i=7 or i=8 or i=10 or i=12 then</SourceLine>
   <SourceLine>maxday = 31</SourceLine>
   <SourceLine>elseif i=4 or i=6 or i=9 or i=11 then</SourceLine>
   <SourceLine>maxday = 30</SourceLine>
   <SourceLine>elseif (whichDate.year/4.0) = floor(whichDate.year/4.0) then</SourceLine>
   <SourceLine>maxday = 29</SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>maxday = 28</SourceLine>
   <SourceLine>end if </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//update all the captions of the buttons and hide as appropriate</SourceLine>
   <SourceLine>DofW = whichDate.dayofweek</SourceLine>
   <SourceLine>for i = 0 to 36</SourceLine>
   <SourceLine>DayNum = i+2-Dofw</SourceLine>
   <SourceLine>if DayNum&gt;0 and DayNum&lt;=maxday then</SourceLine>
   <SourceLine>BevelButton1(i).caption = Str(DayNum)</SourceLine>
   <SourceLine>BevelButton1(i).visible = true</SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>BevelButton1(i).visible = false</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine>next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
