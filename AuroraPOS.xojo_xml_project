   <NoteLine>New_Init_Code_From_Melli</NoteLine>
   <NoteLine>// Place in</NoteLine>
   <NoteLine>#if TargetMacOS then</NoteLine>
   <NoteLine>dim macbundleidentifier as String =_</NoteLine>
   <NoteLine>"com."+ kCompanyName+"."+ kProductName</NoteLine>
   <NoteLine>InitPrefFolderFileMac(macbundleidentifier)</NoteLine>
   <NoteLine>#else</NoteLine>
   <NoteLine>InitPrefFolderFileWinLinux(kProductName, kCompanyName)</NoteLine>
