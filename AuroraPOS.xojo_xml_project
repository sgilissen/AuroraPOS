    <SourceLine>DrawerValue = rs.Field("allow_drawer")</SourceLine>
    <SourceLine>VoidBillValue = rs.Field("allow_voidbill")</SourceLine>
    <SourceLine>EndDayValue =rs.Field("allow_endday")</SourceLine>
    <SourceLine>ReportsValue = rs.Field("allow_reports")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>wndAddEditUser.tfName.Text = rs.Field("name")</SourceLine>
    <SourceLine>wndAddEditUser.tfRFID.Text = rs.Field("rfid")</SourceLine>
    <SourceLine>wndAddEditUser.tfIDCode.Text = rs.Field("loginpass")</SourceLine>
    <SourceLine>if BOValue = "1" Then</SourceLine>
    <SourceLine>wndAddEditUser.cbBackOffice.Value = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>wndAddEditUser.cbBackOffice.Value = False</SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>if DrawerValue = "1" Then</SourceLine>
    <SourceLine>wndAddEditUser.cbCashDrawer.Value = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>wndAddEditUser.cbCashDrawer.Value = False</SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>if VoidBillValue = "1" Then</SourceLine>
    <SourceLine>wndAddEditUser.cbVoidBill.Value = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>wndAddEditUser.cbVoidBill.Value = False</SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>if EndDayValue = "1" Then</SourceLine>
    <SourceLine>wndAddEditUser.cbEndDayTotal.Value = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>wndAddEditUser.cbEndDayTotal.Value = False</SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>if ReportsValue = "1" Then</SourceLine>
    <SourceLine>wndAddEditUser.cbReportFunction.Value = True</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>wndAddEditUser.cbReportFunction.Value = False</SourceLine>
    <SourceLine>End if</SourceLine>
    <SourceLine>wndAddEditUser.EditUserMode = True</SourceLine>
    <SourceLine>wndAddEditUser.EditUserID = Cdbl(lbUsers.Cell(lbUsers.ListIndex, 0))</SourceLine>
    <SourceLine>rs.Close</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>end if</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>
