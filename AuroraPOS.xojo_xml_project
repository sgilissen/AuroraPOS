 <HookInstance>
  <ItemName>Open</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>95016959</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Open()</SourceLine>
   <SourceLine>lblMessage.Text = Message</SourceLine>
   <SourceLine>lblTitle.Text = MessageTitle</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Message Types:</SourceLine>
   <SourceLine>//</SourceLine>
   <SourceLine>// 1 = Red</SourceLine>
   <SourceLine>// 2 = Green</SourceLine>
   <SourceLine>// 3 = Orange</SourceLine>
   <SourceLine>// 4 = Timed Orange, after timeout = Cancel</SourceLine>
   <SourceLine>// 5 = question </SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>beep</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Buttons = 0 Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ASBtnLeft.Visible = False</SourceLine>
   <SourceLine>ASBtnRight.ButtonCaption = dyBtnOK(GetPrefString("applanguage", "en"))</SourceLine>
   <SourceLine>ASBtnRight.ButtonColor = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf Buttons = 1 Then</SourceLine>
   <SourceLine>ASBtnLeft.Visible = True</SourceLine>
   <SourceLine>ASBtnRight.Visible = True</SourceLine>
   <SourceLine>ASBtnLeft.ButtonCaption = dyBtnCancel(GetPrefString("applanguage", "en"))</SourceLine>
   <SourceLine>ASBtnRight.ButtonCaption = dyBtnOK(GetPrefString("applanguage", "en"))</SourceLine>
   <SourceLine>ASBtnLeft.ButtonColor = 1</SourceLine>
   <SourceLine>ASBtnLeft.ButtonColor = 2</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf Buttons = 4 Then</SourceLine>
   <SourceLine>ASBtnLeft.Visible = True</SourceLine>
   <SourceLine>ASBtnRight.Visible = True</SourceLine>
   <SourceLine>ASBtnLeft.ButtonCaption = dyBtnNo(GetPrefString("applanguage", "en"))</SourceLine>
   <SourceLine>ASBtnRight.ButtonCaption = dyBtnYes(GetPrefString("applanguage", "en"))</SourceLine>
   <SourceLine>ASBtnLeft.ButtonColor = 1</SourceLine>
   <SourceLine>ASBtnRight.ButtonColor = 2</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>ASBtnLeft.Visible = False</SourceLine>
   <SourceLine>ASBtnRight.ButtonCaption = dyBtnOK(GetPrefString("applanguage", "en"))</SourceLine>
   <SourceLine>ASBtnRight.ButtonColor = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>cnvSymbol.Refresh</SourceLine>
   <SourceLine>if MessageType = 1 Then</SourceLine>
   <SourceLine>lblTimer.Visible = False</SourceLine>
   <SourceLine>//cnvSymbol.DrawInto(graphics.DrawCautionIcon,0,0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf MessageType = 2 Then</SourceLine>
   <SourceLine>lblTimer.Visible = False</SourceLine>
   <SourceLine>//cnvSymbol.DrawInto(graphics.DrawCautionIcon,0,0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf MessageType = 3 Then</SourceLine>
   <SourceLine>lblTimer.Visible = False</SourceLine>
   <SourceLine>//cnvSymbol.DrawInto(graphics.DrawCautionIcon,0,0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf MessageType = 4 Then</SourceLine>
   <SourceLine>lblTimer.Visible = False</SourceLine>
   <SourceLine>//lblTimer.Text = str(Seconds2Close)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if Seconds2Close &lt; 1 Then</SourceLine>
   <SourceLine>okPressed = False</SourceLine>
   <SourceLine>self.hide</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Seconds2Close = Seconds2Close - 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>//cnvSymbol.DrawInto(graphics.DrawCautionIcon,0,0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>lblTimer.Visible = False</SourceLine>
   <SourceLine>//cnvSymbol.DrawInto(graphics.DrawCautionIcon,0,0)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
