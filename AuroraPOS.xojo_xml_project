   <SourceLine>System.DebugLog("Before check:" + len(Caption).ToString)</SourceLine>
   <SourceLine>If len(Caption)&lt; charsWide Then</SourceLine>
   <SourceLine>RemainingChars = CharsWide - len(Caption)</SourceLine>
   <SourceLine>System.DebugLog("Remaining chars " + RemainingChars.ToString)</SourceLine>
   <SourceLine>for Char As Integer = len(Caption) to charsWide</SourceLine>
   <SourceLine>Caption = Caption + " "</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>System.DebugLog(Caption)</SourceLine>
   <SourceLine>System.DebugLog("After Check" + len(Caption).ToString)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Split chars and get last character</SourceLine>
   <SourceLine>myCharacter() = Split(Caption, "")</SourceLine>
   <SourceLine>NumChar = len(Caption)-1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Draw each char</SourceLine>
   <SourceLine>If NumChar &gt; -1 Then</SourceLine>
   <SourceLine>For x As Integer = 0 To NumChar</SourceLine>
   <SourceLine>StartPosX = x * 32</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var ch As String = myCharacter(x)</SourceLine>
   <SourceLine>Var pattern() As String = FontMap.Lookup(ch, FontMap.Value(" "))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>For row As Integer = 0 To 6</SourceLine>
   <SourceLine>For col As Integer = 0 To 4</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If pattern(row).Middle(col,1) = "1" Then</SourceLine>
   <SourceLine>g.ForeColor = MyForeColor</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>g.ForeColor = MyBackColor</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>g.FillRect(StartPosX + col*6, 2 + row*6, 4, 4)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
