  <PartID>231432191</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function GetPrefBoolean(fieldName as string, default as boolean) As Boolean</SourceLine>
   <SourceLine>Dim strBoolean as string</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>strBoolean="false"</SourceLine>
   <SourceLine>if default then</SourceLine>
   <SourceLine>strBoolean="true"</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>strBoolean=GetPrefString(fieldName,strBoolean)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if strBoolean="true" then</SourceLine>
   <SourceLine>return true</SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>return false</SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>fieldName as string, default as boolean</ItemParams>
  <ItemResult>Boolean</ItemResult>
