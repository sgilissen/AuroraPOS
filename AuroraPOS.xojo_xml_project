 <Method>
  <ItemName>DisplayDatabaseError</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>130070527</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub DisplayDatabaseError(database as SQLiteDatabase, doRollback as boolean)</SourceLine>
   <SourceLine>// Display a dialog that shows information about the error that</SourceLine>
   <SourceLine>// has occurred from the database engine.  If requested a Rollback</SourceLine>
   <SourceLine>// will also happen on the database in order to undo any changes</SourceLine>
   <SourceLine>// that happened since the last commit.</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>MsgBox "Database Error: " + str(MainDB.ErrorCode) + EndOfLine + EndOfLine + MainDB.ErrorMessage</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Rollback changes to the database if specified</SourceLine>
   <SourceLine>if doRollback then</SourceLine>
   <SourceLine>MainDB.rollback</SourceLine>
   <SourceLine>end</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>database as SQLiteDatabase, doRollback as boolean</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>CreateDatabaseFile</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1516361727</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub CreateDatabaseFile()</SourceLine>
   <SourceLine>// Create the database file</SourceLine>
   <SourceLine>dim Row As New DatabaseRecord</SourceLine>
   <SourceLine>MsgBox("Er zijn geen databanken gevonden. Er wordt een standaard lege databank aangemaakt.")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if App.MainDB.DatabaseFile.Exists = False Then</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if App.MainDB.CreateDatabaseFile = false then</SourceLine>
   <SourceLine>// Error While Creating the Database</SourceLine>
   <SourceLine>MsgBox "Database Error" + EndOfLine + EndOfLine + "Er is een fout opgetreden bij het aanmaken van de datatabase voor de artikelen."</SourceLine>
   <SourceLine>Quit</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Create the tables for the database</SourceLine>
   <SourceLine>App.MainDB.SQLExecute("CREATE TABLE pos_articles (id Integer PRIMARY KEY AUTOINCREMENT, name VarChar, price Double, vat VarChar, GroupID INTEGER, btncolor TEXT, textcolor TEXT)")</SourceLine>
   <SourceLine>App.MainDB.SQLExecute("CREATE TABLE pos_groups (id INTEGER PRIMARY KEY AUTOINCREMENT, name VarChar)")</SourceLine>
   <SourceLine>App.MainDB.SQLExecute("CREATE TABLE pos_users (id INTEGER PRIMARY KEY AUTOINCREMENT, name VarChar, rfid VarChar, loginpass VarChar, allow_backoffice INTEGER, allow_drawer INTEGER, allow_voidbill INTEGER, allow_endday INTEGER, allow_reports INTEGER)")</SourceLine>
   <SourceLine>MsgBox("Nieuwe databank is aangemaakt. Herstart de applicatie met de -forcebo switch om de backoffice te openen.")</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Create a default user</SourceLine>
   <SourceLine>App.MainDB.Commit</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.MainDB.Close</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End if</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>if App.TicketDB.DatabaseFile.Exists = False Then</SourceLine>
   <SourceLine>''</SourceLine>
   <SourceLine>if App.TicketDB.CreateDatabaseFile = false then</SourceLine>
   <SourceLine>// Error While Creating the Database</SourceLine>
   <SourceLine>MsgBox "Database Error" + EndOfLine + EndOfLine + "Er is een fout opgetreden bij het aanmaken van de datatabase voor de artikelen."</SourceLine>
   <SourceLine>Quit</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>App.TicketDB.SQLExecute("CREATE TABLE pos_sales (id Integer PRIMARY KEY AUTOINCREMENT, billid Integer, article VarChar, amount Integer, price Double, total Double, timestamp VarChar, day VarChar, month VarChar, year VarChar, paymentmethod VarChar,employee VarChar, billvoid INTEGER, groupid INTEGER, vatid INTEGER)")</SourceLine>
   <SourceLine>App.TicketDB.SQLExecute("CREATE TABLE pos_openbills (id Integer PRIMARY KEY AUTOINCREMENT, billid Integer, customername VARCHAR, article VarChar, amount Integer, price Double, total Double, timestamp VarChar, day VarChar, month VarChar, year VarChar, paymentmethod VarChar, employee VarChar, billvoid INTEGER, groupid INTEGER, vatid INTEGER)")</SourceLine>
   <SourceLine>App.TicketDB.Commit</SourceLine>
   <SourceLine>App.TicketDB.Close</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>else</SourceLine>
   <SourceLine>if App.TicketDB.Error then</SourceLine>
   <SourceLine>msgBox("Error: " + App.TicketDB.ErrorMessage)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>end if</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
