    <SourceLine>TextColor = rs.Field("textcolor").Value.ColorValue</SourceLine>
    <SourceLine>ArtID = rs.Field("id")</SourceLine>
    <SourceLine>VATID = rs.Field("vat")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Art = New Article(ArtName, BtnColor, Price, TextColor, ArtID, false, false, ArtGroupID, Cdbl(VATID))</SourceLine>
    <SourceLine>ButtonGrid1.Buttons.Append(Art)</SourceLine>
    <SourceLine>rs.moveNext// move to the next record</SourceLine>
    <SourceLine>wend</SourceLine>
    <SourceLine>else</SourceLine>
    <SourceLine>msgbox "Er zijn geen artikelen gevonden. Gelieve de BackOffice te openen."</SourceLine>
    <SourceLine>end if </SourceLine>
    <SourceLine>'</SourceLine>
    <SourceLine>'</SourceLine>
    <SourceLine>'Art = New Article("Cola", rgb(250,220,220), 1.90, rgb(0,0,0), "30")</SourceLine>
    <SourceLine>'ButtonGrid1.Buttons.Append(Art)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If GetPrefBoolean("VATDivers1", false) = True Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>BtnColor = RGB(145,217,255)</SourceLine>
    <SourceLine>TextColor = RGB(0,0,0)</SourceLine>
    <SourceLine>Art = New Article("Divers " + GetPrefString("VATPercentage1", "") + "%", BtnColor, 0, TextColor, "DIV1", True, True, 0, 1)</SourceLine>
    <SourceLine>ButtonGrid1.Buttons.Append(Art)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If GetPrefBoolean("VATDivers2", false) = True Then</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>BtnColor = RGB(145,217,255)</SourceLine>
    <SourceLine>TextColor = RGB(0,0,0)</SourceLine>
    <SourceLine>Art = New Article("Divers " + GetPrefString("VATPercentage2", "") + "%", BtnColor, 0, TextColor, "DIV2", True, True, 0, 2)</SourceLine>
    <SourceLine>ButtonGrid1.Buttons.Append(Art)</SourceLine>
